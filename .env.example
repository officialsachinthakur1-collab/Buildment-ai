# BuildAI Server Environment Configuration
# Copy this file to .env and provide your desired API keys

# Server port (default: 3001)
PORT=3001

# Google Gemini API Key (Recommended - offers a generous free tier at https://aistudio.google.com)
GEMINI_API_KEY=

# Anthropic Claude API Key (Optional)
ANTHROPIC_API_KEY=

# OpenAI API Key (Optional)
OPENAI_API_KEY=
